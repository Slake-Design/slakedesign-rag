{
  "name": "slakedesign-rag",
  "version": "1.0.0",
  "description": "RAG backend for a Stripe API knowledge base. Node.js, Express, in-memory vector search, Gemini embeddings.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.js",
    "ingest:dry": "tsx scripts/ingest.js --dry-run",
    "evaluate": "tsx evaluation/evaluate.js",
    "calibrate": "tsx evaluation/calibrate-threshold.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "pino": "^10.3.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
